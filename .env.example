# Tender & Project Intelligence System
# Автор: Maxi-online
# Общий файл окружения для backend и frontend

# Имя приложения (отображается в API и логах)
APP_NAME="TPIS Backend"

# Префикс API (используется FastAPI)
API_PREFIX="/api"

# Уровень логирования (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL="INFO"

# Подключение к PostgreSQL (логин/пароль/хост/порт/БД)
DATABASE_URL="" # empty

# RabbitMQ для очередей (Celery)
CELERY_BROKER_URL="" # empty
CELERY_RESULT_BACKEND="rpc://"

# Количество циклов обновления данных в сутки
UPDATE_CYCLES_PER_DAY=4

# Seldon API (база и ключ доступа, выдаются провайдером)
SELDON_BASE_URL="" # empty
SELDON_API_KEY="" # empty

# Discovery поиск источников (URL сервиса поиска и ключ)
# Пример URL: https://search.example.com?q={query}
DISCOVERY_SEARCH_URL="https://search.example.com?q={query}"
DISCOVERY_API_KEY="" # empty

# Каталог выгрузок CSV/XLSX/Parquet/PDF/DOCX
EXPORT_DIR="exports"

# Anti‑blocking: прокси, User‑Agent и задержки
HTTP_PROXY_URL="" # empty
USER_AGENT="TPISBot/1.0"
REQUEST_DELAY_MIN=0.5
REQUEST_DELAY_MAX=2.0

# Matching: пороги уверенности
MATCHING_THRESHOLD=0.75
MATCHING_MIN_THRESHOLD=0.3

# Пути к YAML конфигам
SOURCES_CONFIG_PATH="config/sources.yaml"
KEYWORDS_CONFIG_PATH="config/keywords.yaml"

# Perplexity API
PERPLEXITY_API_KEY="" # empty
PERPLEXITY_BASE_URL="https://api.perplexity.ai"
PERPLEXITY_MODEL="sonar-pro"

# Claude через OpenRouter (если Anthropic недоступен напрямую)
OPENROUTER_API_KEY="" # empty
OPENROUTER_BASE_URL="" # empty
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
# Опционально: заголовки для статистики OpenRouter (можно оставить пустыми)
OPENROUTER_APP_URL="" # empty
OPENROUTER_APP_NAME="" # empty

# Dadata и Rusprofile
DADATA_API_KEY="" # empty
DADATA_SECRET_KEY="" # empty
DADATA_MCP_URL="" # empty
RUSPROFILE_BASE_URL="" # empty

# Required private runtime values; do not commit populated credentials.
CELERY_BROKER_URL_ALT_2="" # empty
DADATA_API_KEY_ALT_2="" # empty
DADATA_SECRET_KEY_ALT_2="" # empty
DATABASE_URL_ALT_2="" # empty
DISCOVERY_API_KEY_ALT_2="" # empty
HTTP_PROXY_URL_ALT_2="" # empty
OPENAI_API_KEY="" # empty
PERPLEXITY_API_KEY_ALT_2="" # empty
SERVICES_DB_ENVIRONMENT_POSTGRES_PASSWORD="" # empty

# Required private runtime values; do not commit populated credentials.
EMAIL="" # empty
